diff --git a/src/main/style/starry-night.css b/src/main/style/starry-night.css
new file mode 100644
index 0000000..73db07e
--- /dev/null
+++ b/src/main/style/starry-night.css
@@ -0,0 +1,106 @@
+/* Spicetify StarryNight Base palette and animation, adapted to SteamEdge
+   by @braxffa on 2026-10-04. Original theme authors: Brandon Chen and
+   Julissa Laignelet. See STARRY_NIGHT_NOTICES.md in the repository root. */
+html[data-tema="starry-night"] {
+  --spice-star:#ffffff;
+  --spice-star-glow:#ffffff;
+  --spice-shooting-star:#ffffff;
+  --spice-rgb-shooting-star-glow:255,255,255;
+  --e-bg:#000000; --e-bgAlt:#000000;
+  --e-s1:#152238; --e-s2:#152238; --e-s3:#152238;
+  --e-bdPassive:#142b44; --e-bd:#29435d; --e-bdActive:#6215d6; --e-bdFocus:#6215d6;
+  --e-brand:#6215d6; --e-brandHover:#7932e3; --e-brandActive:#6215d6; --e-brandGlow:#6215d6;
+  --e-title:#ffffff; --e-body:#ffffff; --e-sub:#adb5bd; --e-muted:#adb5bd; --e-off:#7f7f7f;
+  background:#000000;
+}
+
+html[data-tema="starry-night"] body.edge { background:transparent !important; }
+html[data-tema="starry-night"] .starrynight-foreground,
+html[data-tema="starry-night"] .e-titlebar { z-index:1; }
+html[data-tema="starry-night"] .e-titlebar,
+html[data-tema="starry-night"] .e-header,
+html[data-tema="starry-night"] .e-aside,
+html[data-tema="starry-night"] .e-main,
+html[data-tema="starry-night"] :is(#tab-genel,#tab-kart,#tab-env,#tab-saat,#tab-gercekci,#tab-basarim,#tab-sohbet,#tab-ayarlar,#tab-empty) {
+  background:transparent !important;
+}
+html[data-tema="starry-night"] .e-main > section {
+  --bg:#000000; --panel:#152238; --card:#152238; --card2:#152238;
+  --line:#142b44; --line-2:#29435d; --surface:#152238; --surface-2:#152238; --border:#29435d;
+  --blue:#6215d6; --primary:#6215d6; --accent:#6215d6; --purple:#adb5bd;
+  --txt:#ffffff; --text:#ffffff; --muted:#adb5bd; --text-2:#adb5bd; --muted2:#7f7f7f; --text-3:#7f7f7f;
+}
+html[data-tema="starry-night"] .e-btn.primary,
+html[data-tema="starry-night"] .e-seg button.sel,
+html[data-tema="starry-night"] .e-seg .e-seg-item.sel,
+html[data-tema="starry-night"] .lgbtn { color:#ffffff !important; }
+html[data-tema="starry-night"] #tbVersion {
+  color:#6215d6 !important;
+  border-color:#6215d6 !important;
+  background:#f5f0ff;
+  font-weight:700 !important;
+}
+html[data-tema="starry-night"] body > .bg-grid,
+html[data-tema="starry-night"] body > div[style*="filter:blur(120px)"] { display:none !important; }
+html[data-tema="starry-night"] .glow { box-shadow:none; }
+
+/* The original theme places these stars behind Spotify's transparent UI. */
+html[data-tema="starry-night"] #starry-night-sky.starrynight-bg-container {
+  position:fixed; inset:0; width:100vw; height:100vh; z-index:0;
+  pointer-events:none; overflow:hidden; mix-blend-mode:normal;
+  background:linear-gradient(180deg,#000000 0%,#142b44 100%);
+}
+.starrynight-star { position:absolute; border-radius:50%; }
+
+@keyframes twinkle1 {
+  0%,80%,100% { box-shadow:0px 0px 8px 2px var(--spice-star-glow); }
+  20%,40%,60% { box-shadow:0px 0px -8px 2px var(--spice-star-glow); }
+}
+@keyframes twinkle2 {
+  0%,20%,100% { box-shadow:0px 0px 8px 2px var(--spice-star-glow); }
+  40%,60%,80% { box-shadow:0px 0px -8px 2px var(--spice-star-glow); }
+}
+@keyframes twinkle3 {
+  0%,80%,100% { box-shadow:0px 0px -8px 2px var(--spice-star-glow); }
+  20%,40%,60% { box-shadow:0px 0px 8px 2px var(--spice-star-glow); }
+}
+@keyframes twinkle4 {
